{
  "name": "2026-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build": "pnpm --parallel --filter \"./apps/*\" build",
    "build:dashboard": "pnpm --filter dashboard build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.5.0"
}