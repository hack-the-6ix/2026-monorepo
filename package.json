{
  "name": "2026-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:landing": "pnpm --filter landing dev",
    "dev:apply": "pnpm --filter apply dev",
    "dev:hacker": "pnpm --filter hacker dev",
    "dev:ui": "pnpm --filter ui dev",
    "build": "pnpm --parallel --filter \"./apps/*\" build",
    "build:landing": "pnpm --filter landing build",
    "build:apply": "pnpm --filter apply build",
    "build:hacker": "pnpm --filter hacker build",
    "build:ui": "pnpm --filter ui build",
    "type-check": "pnpm -r type-check",
    "typegen": "pnpm -r typegen",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "react-icons": "^5.6.0"
  }
}
