{
  "name": "2026-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:landing": "pnpm --filter landing dev",
    "build": "pnpm --parallel --filter \"./apps/*\" build",
    "build:landing": "pnpm --filter landing build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.5.0"
}