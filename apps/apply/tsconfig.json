{
  "extends": "@hackthe6ix/typescript-config/next",
  "compilerOptions": {
    "types": ["./cloudflare-env.d.ts", "node"]
  },
  "paths": {
    "@/*": ["./src/*"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
