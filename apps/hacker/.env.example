# Hardware portal backend (deployed from the hardware portal repo).
# HARDWARE_API_URL is the server-side base the /api/hardware proxy forwards to;
# NEXT_PUBLIC_HARDWARE_API_URL is the client-side base (defaults to the proxy).
HARDWARE_API_URL=http://localhost:3000
NEXT_PUBLIC_HARDWARE_API_URL=/api/hardware
