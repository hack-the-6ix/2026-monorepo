{
  "name": "@hackthe6ix/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "pnpm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "pnpm run cf:build && opennextjs-cloudflare upload",
    "cf:preview": "pnpm run cf:build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hackthe6ix/eslint-config": "workspace:*",
    "@hackthe6ix/typescript-config": "workspace:*",
    "@opennextjs/cloudflare": "^1.14.4",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.59.3"
  }
}
